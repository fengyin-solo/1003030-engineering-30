# 运行环境参数：端口、代理目标、跨域白名单、页大小上限，前后端只维护这一份。
# 后端 run.sh / uvicorn、前端 vite 代理、docker-compose 都从本文件读；
# 改完保存后运行中的服务会自动按这份重载（后端热重载，前端 dev server 自动重启）。
# 本机临时覆盖用 .env.local（不入库）；进程环境变量优先级最高，老变量继续有效。
APP_ENV=local
APP_PORT=8000
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_PAGE_SIZE_MAX=200
APP_PAGE_SIZE_DEFAULT=20
# 前端代理目标默认跟随 APP_PORT（http://127.0.0.1:<APP_PORT>）；
# 需要指向别的后端时取消下面这行注释（老的环境变量 VITE_PROXY_TARGET 也仍然有效）。
# VITE_PROXY_TARGET=http://127.0.0.1:8000
